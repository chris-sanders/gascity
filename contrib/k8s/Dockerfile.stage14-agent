# Stage 14 deployment augmentation for the source-owned Gas City agent image.
#
# The upstream Dockerfile.agent remains responsible for gc, bd, br, and all
# other runtime dependencies. This layer adds only the public Codex provider
# tooling required by the ArgoCD deployment-side candidate factory.

ARG BASE_IMAGE=gc-agent:source
FROM ${BASE_IMAGE}

USER root

# Public, credential-free Codex integration. The compatibility wrapper keeps
# the frozen provider argv valid for the pinned native CLI.
ARG CODEX_VERSION=0.155.1
ARG CODEX_TARBALL_SHA512=6adbf71c5d26b9ba81d09fd7910d89a29a8acd727effb690b5307632427d32badaba3308cfccdb0822f294b90ddcfce95464c9cf340537fc03d68abca093c92a
ARG CODEX_PLATFORM_PACKAGE=linux-x64
ARG CODEX_TARGET_TRIPLE=x86_64-unknown-linux-musl
COPY contrib/k8s/codex-compat.sh /tmp/codex-compat.sh
RUN set -eux; codex_dir="/opt/codex-${CODEX_VERSION}"; mkdir -p "$codex_dir"; \
    native=/usr/local/libexec/gascity-codex-native; \
    if [ -e "$native" ] || [ -L "$native" ]; then \
      test -x "$native"; \
      test "$("$native" --version)" = "codex-cli ${CODEX_VERSION}"; \
    else \
      curl -fsSL --retry 3 "https://registry.npmjs.org/@openai/codex/-/codex-${CODEX_VERSION}-${CODEX_PLATFORM_PACKAGE}.tgz" -o /tmp/codex.tgz; \
      echo "${CODEX_TARBALL_SHA512}  /tmp/codex.tgz" | sha512sum --check --strict; \
      tar -xzf /tmp/codex.tgz --strip-components=1 -C "$codex_dir"; \
      test -x "$codex_dir/vendor/${CODEX_TARGET_TRIPLE}/bin/codex"; \
      mkdir -p /usr/local/libexec; ln -s "$codex_dir/vendor/${CODEX_TARGET_TRIPLE}/bin/codex" "$native"; \
    fi; \
    install -m 0755 /tmp/codex-compat.sh /usr/local/bin/codex; \
    test "$(/usr/local/bin/codex --version)" = "codex-cli ${CODEX_VERSION}"; rm -f /tmp/codex.tgz /tmp/codex-compat.sh
LABEL io.gascity.codex.version="${CODEX_VERSION}" \
      io.gascity.codex.tarball.sha512="${CODEX_TARBALL_SHA512}" \
      io.gascity.codex.compatibility="frozen-provider-ask-for-approval-v2" \
      io.gascity.stage14.packaging="additive-agent-layer"

ENV CODEX_MANAGED_PACKAGE_ROOT=/opt/codex-${CODEX_VERSION}

# Preserve the source-owned agent runtime identity after the additive root
# installation layer completes.
USER gcagent
